-- CozoDB Schema for Memorycore v2.0
-- Simplified: Local-first memory substrate

-- CORE TABLES
?memories[
    memory_id: str,
    project_id: str,
    content: str,
    evidence: [str],
    created_at: str,
    created_by: str,
    tags: [str],
    memory_type: str,
    summary: str,
    status: str,
    updated_at: str,
    PRIMARY KEY memory_id
]

?projects[
    project_id: str,
    name: str,
    description: str,
    created_at: str,
    created_by: str,
    is_active: bool,
    PRIMARY KEY project_id
]

?sources[
    source_id: str,
    source_type: str,
    reference: str,
    title: str,
    author: str,
    created_at: str,
    metadata: {},
    PRIMARY KEY source_id
]

?memory_links[
    link_id: str,
    from_memory_id: str,
    to_memory_id: str,
    link_type: str,
    created_at: str,
    created_by: str,
    description: str,
    PRIMARY KEY link_id,
    FOREIGN KEY from_memory_id -> memories(memory_id),
    FOREIGN KEY to_memory_id -> memories(memory_id)
]

?supersession_chains[
    chain_id: str,
    old_memory_id: str,
    new_memory_id: str,
    reason: str,
    created_at: str,
    created_by: str,
    PRIMARY KEY chain_id,
    FOREIGN KEY old_memory_id -> memories(memory_id),
    FOREIGN KEY new_memory_id -> memories(memory_id)
]

?contradiction_chains[
    chain_id: str,
    memory_a_id: str,
    memory_b_id: str,
    resolution: str,
    resolution_notes: str,
    created_at: str,
    created_by: str,
    resolved_at: str,
    resolved_by: str,
    PRIMARY KEY chain_id,
    FOREIGN KEY memory_a_id -> memories(memory_id),
    FOREIGN KEY memory_b_id -> memories(memory_id)
]

-- INDEXES
:create ft_index_memories {
    source: memories,
    index content,
    index summary,
    index tags,
    index memory_type,
    index project_id
}

:create idx_memories_project_id on memories(project_id)
:create idx_memories_status on memories(status)
:create idx_memories_type on memories(memory_type)
:create idx_memories_tags on memories(tags)

-- SEARCH FUNCTIONS
:func ft_search_memories(query: str, project_id: ?str, status: ?str,
                         tags: ?[str], memory_type: ?str,
                         limit: ?i64, offset: ?i64) -> [{
    memory_id: str,
    project_id: str,
    content: str,
    summary: str,
    tags: [str],
    memory_type: str,
    status: str,
    created_at: str,
    score: f64
}] {
    search ft_index_memories {
        query: query,
        limit: limit or 100,
        offset: offset or 0
    }
    where project_id is null or project_id == project_id
    where status is null or status == status
    where tags is null or all(t in tags for t in tags)
    where memory_type is null or memory_type == memory_type
    order by score desc
}

:func get_project_stats(project_id: str) -> {
    total: i64,
    active: i64,
    superseded: i64,
    stale: i64,
    archived: i64,
    by_type: {}
} {
    total := count(memories where project_id == project_id)
    active := count(memories where project_id == project_id and status == 'active')
    superseded := count(memories where project_id == project_id and status == 'superseded')
    stale := count(memories where project_id == project_id and status == 'stale')
    archived := count(memories where project_id == project_id and status == 'archived')
    by_type := {}
    for type in ['fact', 'decision', 'correction', 'procedure', 'source', 'task_result', 'preference'] {
        by_type[type] := count(memories where project_id == project_id and memory_type == type)
    }
    return {total, active, superseded, stale, archived, by_type}
}