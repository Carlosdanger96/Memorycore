-- ============================================================================
-- AGGREGATION FUNCTIONS
-- ============================================================================

-- Count memories by project
:func count_memories_by_project(project_id: str) -> i64 {
    count(memories_by_project[project_id])
}

-- Count memories by status
:func count_memories_by_status(project_id: str, status: str) -> i64 {
    count(memories(project_id, memory_id, content, source_refs, created_at, created_by, tags, confidence, status, memory_type, summary, raw_evidence_ref, trust_score, approval_status, updated_at, version)
        where status == status)
}

-- Get all tags for a project
:func get_project_tags(project_id: str) -> [str] {
    unique(t for memories(project_id, memory_id, content, source_refs, created_at, created_by, tags, confidence, status, memory_type, summary, raw_evidence_ref, trust_score, approval_status, updated_at, version) for t in tags)
}

-- Get project statistics
:func get_project_stats(project_id: str) -> {
    total: i64,
    accepted: i64,
    candidate: i64,
    archived: i64,
    tags: [str]
} {
    total: count(memories_by_project[project_id]),
    accepted: count_memories_by_status(project_id, 'accepted'),
    candidate: count_memories_by_status(project_id, 'candidate'),
    archived: count_memories_by_status(project_id, 'archived'),
    tags: get_project_tags(project_id)
}

-- ============================================================================
-- INITIAL DATA (Optional - for bootstrap)
-- ============================================================================

-- Default status values
:put memories(status: 'candidate')
:put memories(status: 'accepted')
:put memories(status: 'archived')

-- Default memory types
:put memories(memory_type: 'fact')
:put memories(memory_type: 'decision')
:put memories(memory_type: 'design')
:put memories(memory_type: 'task')
:put memories(memory_type: 'reference')
:put memories(memory_type: 'warning')
:put memories(memory_type: 'experiment')

-- Default link types
:put memory_links(link_type: 'related')
:put memory_links(link_type: 'derived')
:put memory_links(link_type: 'contradicts')
:put memory_links(link_type: 'supersedes')
:put memory_links(link_type: 'references')
:put memory_links(link_type: 'depends_on')

-- Default source types
:put sources(source_type: 'chat')
:put sources(source_type: 'file')
:put sources(source_type: 'github')
:put sources(source_type: 'manual')
:put sources(source_type: 'tool')
:put sources(source_type: 'web')

-- Default approval statuses
:put memories(approval_status: 'candidate')
:put memories(approval_status: 'accepted')
:put memories(approval_status: 'rejected')
:put memories(approval_status: 'archived')

-- Default resolution types for contradictions
:put contradiction_chains(resolution: 'unresolved')
:put contradiction_chains(resolution: 'resolved')
:put contradiction_chains(resolution: 'merged')
:put contradiction_chains(resolution: 'deprecated_a')
:put contradiction_chains(resolution: 'deprecated_b')
