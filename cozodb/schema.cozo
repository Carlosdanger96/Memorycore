-- CozoDB Schema for Memorycore
-- Primary memory store: graph/relation/vector/FTS
-- Version: 2.0.0 - Phase 3: Vector Search

-- ============================================================================
-- CORE TABLES
-- ============================================================================

-- Memories table - stores all memory records
-- Vector embeddings: 768-dim float32 vectors (sentence-transformers compatible)
?memories[
    memory_id: str,
    project_id: str,
    content: str,
    source_refs: [str],
    created_at: str,
    created_by: str,
    tags: [str],
    confidence: f64,
    status: str,
    memory_type: str,
    summary: str,
    raw_evidence_ref: str,
    trust_score: f64,
    approval_status: str,
    updated_at: str,
    version: i64,
    vector_embedding: [f32],  -- 768-dim float32 vector for semantic search
    PRIMARY KEY memory_id
]

-- Projects table - for access control and organization
?projects[
    project_id: str,
    name: str,
    description: str,
    created_at: str,
    created_by: str,
    is_active: bool,
    PRIMARY KEY project_id
]

-- Sources table - tracks where memories came from
?sources[
    source_id: str,
    source_type: str,  -- chat | file | github | manual | tool | web
    reference: str,    -- URL, file path, commit hash, etc.
    title: str,
    author: str,
    created_at: str,
    metadata: {},
    PRIMARY KEY source_id
]

-- Tags table - for categorization
?tags[
    tag_id: str,
    name: str,
    description: str,
    created_at: str,
    created_by: str,
    PRIMARY KEY tag_id
]

-- ============================================================================
-- RELATIONSHIP TABLES (Graph Structure)
-- ============================================================================

-- Memory links - bidirectional relationships between memories
?memory_links[
    link_id: str,
    from_memory_id: str,
    to_memory_id: str,
    link_type: str,  -- related | derived | contradicts | supersedes | references | depends_on
    created_at: str,
    created_by: str,
    strength: f64,   -- 0.0 to 1.0
    description: str,
    PRIMARY KEY link_id,
    FOREIGN KEY from_memory_id -> memories(memory_id),
    FOREIGN KEY to_memory_id -> memories(memory_id)
]

-- Supersession chains - tracks when a memory replaces another
?supersession_chains[
    chain_id: str,
    old_memory_id: str,
    new_memory_id: str,
    reason: str,
    created_at: str,
    created_by: str,
    is_active: bool,
    PRIMARY KEY chain_id,
    FOREIGN KEY old_memory_id -> memories(memory_id),
    FOREIGN KEY new_memory_id -> memories(memory_id)
]

-- Contradiction chains - tracks when memories contradict each other
?contradiction_chains[
    chain_id: str,
    memory_a_id: str,
    memory_b_id: str,
    resolution: str,  -- unresolved | resolved | merged | deprecated_a | deprecated_b
    resolution_notes: str,
    created_at: str,
    created_by: str,
    resolved_at: str,
    resolved_by: str,
    PRIMARY KEY chain_id,
    FOREIGN KEY memory_a_id -> memories(memory_id),
    FOREIGN KEY memory_b_id -> memories(memory_id)
]

-- ============================================================================
-- INDEXES
-- ============================================================================

-- Full-Text Search Index on memories
:create ft_index_memories {
    source: memories,
    index content,
    index summary,
    index tags,
    index memory_type,
    index project_id
}

-- HNSW Vector Index for semantic search
-- 768-dimensional float32 vectors (sentence-transformers compatible)
-- M=16: Maximum number of bidirectional links per node
-- efConstruction=200: Construction time search depth (higher = better quality, slower)
-- metric: cosine similarity
:create vector_index_memories {
    source: memories,
    index vector_embedding: vector(f32, 768),
    algorithm: hnsw,
    metric: cosine,
    M: 16,
    efConstruction: 200
}

-- Hybrid index combining FTS and vector search
-- Allows filtering by project_id, status, tags while searching vectors
:create hybrid_index_memories {
    source: memories,
    index content,
    index summary,
    index tags,
    index memory_type,
    index project_id,
    index vector_embedding: vector(f32, 768),
    algorithm: hnsw,
    metric: cosine,
    M: 16,
    efConstruction: 200
}

-- Regular indexes for performance
:create idx_memories_project_id on memories(project_id)
:create idx_memories_status on memories(status)
:create idx_memories_created_at on memories(created_at)
:create idx_memories_created_by on memories(created_by)
:create idx_memories_confidence on memories(confidence)
:create idx_memories_trust_score on memories(trust_score)
:create idx_memories_tags on memories(tags)
:create idx_memories_memory_type on memories(memory_type)

:create idx_projects_created_by on projects(created_by)
:create idx_projects_is_active on projects(is_active)

:create idx_sources_source_type on sources(source_type)
:create idx_sources_created_by on sources(created_by)

:create idx_memory_links_from on memory_links(from_memory_id)
:create idx_memory_links_to on memory_links(to_memory_id)
:create idx_memory_links_type on memory_links(link_type)

:create idx_supersession_old on supersession_chains(old_memory_id)
:create idx_supersession_new on supersession_chains(new_memory_id)
:create idx_supersession_active on supersession_chains(is_active)

:create idx_contradiction_a on contradiction_chains(memory_a_id)
:create idx_contradiction_b on contradiction_chains(memory_b_id)
:create idx_contradiction_resolution on contradiction_chains(resolution)

-- ============================================================================
-- RULES FOR DERIVED DATA
-- ============================================================================

-- Rule: Get all memories for a project
memories_by_project[filter_project_id: str] <-
    memories(project_id, memory_id, content, source_refs, created_at, created_by, tags, confidence, status, memory_type, summary, raw_evidence_ref, trust_score, approval_status, updated_at, version)
    where project_id == filter_project_id

-- Rule: Get all active memories (not archived)
active_memories[] <-
    memories(memory_id, project_id, content, source_refs, created_at, created_by, tags, confidence, status, memory_type, summary, raw_evidence_ref, trust_score, approval_status, updated_at, version)
    where status != 'archived'

-- Rule: Get all accepted memories
accepted_memories[] <-
    memories(memory_id, project_id, content, source_refs, created_at, created_by, tags, confidence, status, memory_type, summary, raw_evidence_ref, trust_score, approval_status, updated_at, version)
    where status == 'accepted'

-- Rule: Get all candidate memories
candidate_memories[] <-
    memories(memory_id, project_id, content, source_refs, created_at, created_by, tags, confidence, status, memory_type, summary, raw_evidence_ref, trust_score, approval_status, updated_at, version)
    where status == 'candidate'

-- Rule: Get memories by tag
memories_by_tag[tag: str] <-
    memories(memory_id, project_id, content, source_refs, created_at, created_by, tags, confidence, status, memory_type, summary, raw_evidence_ref, trust_score, approval_status, updated_at, version)
    where tag in tags

-- Rule: Get memories by multiple tags (AND logic)
memories_by_tags[filter_tags: [str]] <-
    memories(memory_id, project_id, content, source_refs, created_at, created_by, tags, confidence, status, memory_type, summary, raw_evidence_ref, trust_score, approval_status, updated_at, version)
    where all(t in tags for t in filter_tags)

-- Rule: Get memories created by a user
memories_by_user[user_id: str] <-
    memories(memory_id, project_id, content, source_refs, created_at, created_by, tags, confidence, status, memory_type, summary, raw_evidence_ref, trust_score, approval_status, updated_at, version)
    where created_by == user_id

-- Rule: Get all links from a memory
links_from_memory[from_memory_id: str] <-
    memory_links(link_id, from_memory_id, to_memory_id, link_type, created_at, created_by, strength, description)

-- Rule: Get all links to a memory
links_to_memory[to_memory_id: str] <-
    memory_links(link_id, from_memory_id, to_memory_id, link_type, created_at, created_by, strength, description)

-- Rule: Get supersession chain for a memory (old memories it supersedes)
superseded_by[new_memory_id: str] <-
    supersession_chains(chain_id, old_memory_id, new_memory_id, reason, created_at, created_by, is_active)
    where is_active == true

-- Rule: Get supersession chain for a memory (new memories that supersede it)
supersedes[old_memory_id: str] <-
    supersession_chains(chain_id, old_memory_id, new_memory_id, reason, created_at, created_by, is_active)
    where is_active == true

-- Rule: Get contradiction chains for a memory
contradictions_for_memory[memory_id: str] <-
    contradiction_chains(chain_id, memory_a_id, memory_b_id, resolution, resolution_notes, created_at, created_by, resolved_at, resolved_by)
    where memory_id == memory_a_id or memory_id == memory_b_id

-- Rule: Get unresolved contradictions
unresolved_contradictions[] <-
    contradiction_chains(chain_id, memory_a_id, memory_b_id, resolution, resolution_notes, created_at, created_by, resolved_at, resolved_by)
    where resolution == 'unresolved'

-- ============================================================================
-- SEARCH FUNCTIONS
-- ============================================================================

-- Full-text search function
:func ft_search_memories(query: str, filter_project_id: ?str, filter_status: ?str, filter_tags: ?[str], limit: ?i64, offset: ?i64) -> [{
    memory_id: str,
    project_id: str,
    content: str,
    summary: str,
    tags: [str],
    confidence: f64,
    trust_score: f64,
    status: str,
    created_at: str,
    score: f64
}] {
    search ft_index_memories {
        query: query,
        limit: limit or 100,
        offset: offset or 0
    }
    where filter_project_id is null or project_id == filter_project_id
    where filter_status is null or status == filter_status
    where filter_tags is null or all(t in tags for t in filter_tags)
    order by score desc
}

-- Vector search function
-- Searches 768-dim float32 vectors using HNSW index with cosine similarity
:func vector_search_memories(query_embedding: [f32], filter_project_id: ?str, filter_status: ?str, filter_tags: ?[str], limit: ?i64, ef_search: ?i64) -> [{
    memory_id: str,
    project_id: str,
    content: str,
    summary: str,
    tags: [str],
    confidence: f64,
    trust_score: f64,
    status: str,
    created_at: str,
    score: f64  -- Cosine similarity score (0.0 to 1.0, higher is more similar)
}] {
    search vector_index_memories {
        query: query_embedding,
        limit: limit or 100,
        ef: ef_search or 100
    }
    where filter_project_id is null or project_id == filter_project_id
    where filter_status is null or status == filter_status
    where filter_tags is null or all(t in tags for t in filter_tags)
    order by score desc
}

-- Hybrid search function: combines vector + FTS
-- Returns results that match either vector similarity or text query
:func hybrid_search_memories(query: str, query_embedding: ?[f32], filter_project_id: ?str, filter_status: ?str, filter_tags: ?[str], limit: ?i64, vector_weight: ?f64, text_weight: ?f64) -> [{
    memory_id: str,
    project_id: str,
    content: str,
    summary: str,
    tags: [str],
    confidence: f64,
    trust_score: f64,
    status: str,
    created_at: str,
    vector_score: ?f64,
    text_score: ?f64,
    combined_score: f64
}] {
    -- Get vector results if embedding provided
    if query_embedding is not null {
        vector_results := vector_search_memories(
            query_embedding: query_embedding,
            filter_project_id: filter_project_id,
            filter_status: filter_status,
            filter_tags: filter_tags,
            limit: limit or 100,
            ef_search: 100
        )
    } else {
        vector_results := []
    }
    
    -- Get text results if query provided
    if query != "" and query is not null {
        text_results := ft_search_memories(
            query: query,
            filter_project_id: filter_project_id,
            filter_status: filter_status,
            filter_tags: filter_tags,
            limit: limit or 100,
            offset: 0
        )
    } else {
        text_results := []
    }
    
    -- Combine and deduplicate results
    combined := {}
    
    -- Add vector results
    for vr in vector_results {
        if vr.memory_id not in combined {
            combined[vr.memory_id] := {
                memory_id: vr.memory_id,
                project_id: vr.project_id,
                content: vr.content,
                summary: vr.summary,
                tags: vr.tags,
                confidence: vr.confidence,
                trust_score: vr.trust_score,
                status: vr.status,
                created_at: vr.created_at,
                vector_score: vr.score,
                text_score: 0.0,
                combined_score: 0.0
            }
        }
        combined[vr.memory_id].vector_score = vr.score
    }
    
    -- Add text results
    for tr in text_results {
        if tr.memory_id not in combined {
            combined[tr.memory_id] := {
                memory_id: tr.memory_id,
                project_id: tr.project_id,
                content: tr.content,
                summary: tr.summary,
                tags: tr.tags,
                confidence: tr.confidence,
                trust_score: tr.trust_score,
                status: tr.status,
                created_at: tr.created_at,
                vector_score: 0.0,
                text_score: tr.score,
                combined_score: 0.0
            }
        }
        combined[tr.memory_id].text_score = tr.score
    }
    
    -- Calculate combined scores with weights
    results := []
    for mem_id, data in combined {
        v_score := data.vector_score or 0.0
        t_score := data.text_score or 0.0
        
        -- Normalize scores to [0, 1] range
        v_norm := v_score  -- Already 0-1 for cosine
        t_norm := t_score / 100.0  -- FTS scores can be higher
        
        -- Apply weights (default: equal weight)
        v_weight := vector_weight or 0.5
        t_weight := text_weight or 0.5
        
        -- Combined score (weighted sum)
        combined_score := (v_norm * v_weight) + (t_norm * t_weight)
        
        results.append({
            memory_id: data.memory_id,
            project_id: data.project_id,
            content: data.content,
            summary: data.summary,
            tags: data.tags,
            confidence: data.confidence,
            trust_score: data.trust_score,
            status: data.status,
            created_at: data.created_at,
            vector_score: v_score,
            text_score: t_score,
            combined_score: combined_score
        })
    }
    
    -- Sort by combined score descending
    order by combined_score desc
    limit limit or 100
}

-- Nearest neighbor search with filters
:func nn_search_memories(query_embedding: [f32], filter_project_id: str, limit: ?i64, min_score: ?f64) -> [{
    memory_id: str,
    project_id: str,
    content: str,
    score: f64
}] {
    search vector_index_memories {
        query: query_embedding,
        limit: limit or 100,
        ef: 100,
        filter: project_id == filter_project_id
    }
    where score >= (min_score or 0.0)
    order by score desc
}

-- ============================================================================
-- AGGREGATION FUNCTIONS
-- ============================================================================

-- Count memories by project
:func count_memories_by_project(project_id: str) -> i64 {
    count(memories_by_project[project_id])
}

-- Count memories by status
:func count_memories_by_status(project_id: str, filter_status: str) -> i64 {
    count(memories(project_id, memory_id, content, source_refs, created_at, created_by, tags, confidence, status, memory_type, summary, raw_evidence_ref, trust_score, approval_status, updated_at, version)
        where status == filter_status)
}

-- Get all tags for a project
:func get_project_tags(project_id: str) -> [str] {
    unique(t for memories(project_id, memory_id, content, source_refs, created_at, created_by, tags, confidence, status, memory_type, summary, raw_evidence_ref, trust_score, approval_status, updated_at, version) for t in tags)
}

-- Get project statistics
:func get_project_stats(project_id: str) -> {
    total: i64,
    accepted: i64,
    candidate: i64,
    archived: i64,
    tags: [str]
} {
    total: count(memories_by_project[project_id]),
    accepted: count_memories_by_status(project_id, 'accepted'),
    candidate: count_memories_by_status(project_id, 'candidate'),
    archived: count_memories_by_status(project_id, 'archived'),
    tags: get_project_tags(project_id)
}

-- ============================================================================
-- INITIAL DATA (Optional - for bootstrap)
-- ============================================================================

-- Default status values
:put memories(status: 'candidate')
:put memories(status: 'accepted')
:put memories(status: 'archived')

-- Default memory types
:put memories(memory_type: 'fact')
:put memories(memory_type: 'decision')
:put memories(memory_type: 'design')
:put memories(memory_type: 'task')
:put memories(memory_type: 'reference')
:put memories(memory_type: 'warning')
:put memories(memory_type: 'experiment')

-- Default link types
:put memory_links(link_type: 'related')
:put memory_links(link_type: 'derived')
:put memory_links(link_type: 'contradicts')
:put memory_links(link_type: 'supersedes')
:put memory_links(link_type: 'references')
:put memory_links(link_type: 'depends_on')

-- Default source types
:put sources(source_type: 'chat')
:put sources(source_type: 'file')
:put sources(source_type: 'github')
:put sources(source_type: 'manual')
:put sources(source_type: 'tool')
:put sources(source_type: 'web')

-- Default approval statuses
:put memories(approval_status: 'candidate')
:put memories(approval_status: 'accepted')
:put memories(approval_status: 'rejected')
:put memories(approval_status: 'archived')

-- Default resolution types for contradictions
:put contradiction_chains(resolution: 'unresolved')
:put contradiction_chains(resolution: 'resolved')
:put contradiction_chains(resolution: 'merged')
:put contradiction_chains(resolution: 'deprecated_a')
:put contradiction_chains(resolution: 'deprecated_b')
