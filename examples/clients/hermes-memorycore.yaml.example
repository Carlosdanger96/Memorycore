# Merge under mcp_servers in a private Hermes config for an isolated test.
# Replace the placeholder with Hermes' own token from the private registry.
mcp_servers:
  memorycore:
    url: http://127.0.0.1:8000/mcp
    timeout: 60
    connect_timeout: 15
    headers:
      Authorization: Bearer REPLACE_WITH_PRIVATE_HERMES_TOKEN
