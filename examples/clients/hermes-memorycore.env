# Use these environment values in Hermes when launching its Memorycore stdio MCP process.
MEMORYCORE_DB=C:\PATH\TO\Memorycore\data\memorycore.db
MEMORYCORE_CLIENT_ID=hermes
MEMORYCORE_CLIENT_ROLE=reader
MEMORYCORE_ALLOWED_PROJECTS=hermesbag
MEMORYCORE_READ_ONLY=true
MEMORYCORE_MODEL_PROVIDER=ollama-cloud
