# Central service storage. Do not commit real credentials.
MEMORYCORE_DATABASE_URL=postgresql+psycopg://memorycore:change-me-before-sharing@127.0.0.1:5432/memorycore
MEMORYCORE_TRANSPORT=streamable-http
MEMORYCORE_HOST=127.0.0.1
MEMORYCORE_PORT=8000

# During the local prototype, one central service is the authority.
MEMORYCORE_CLIENT_ID=memorycore-service
MEMORYCORE_CLIENT_ROLE=administrator
